{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SupabaseDatabase": "Host=your-supabase-db.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_PASSWORD"
  },
  "Database": {
    "SqlitePath": "../../database/cakeshop_local.db"
  },
